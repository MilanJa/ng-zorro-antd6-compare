ss=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>filled<span class=\"token punctuation\">\"</span></span> <span class=\"token attr-name\">nzColor</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>success<span class=\"token punctuation\">\"</span></span> <span class=\"token attr-name\">nzIcon</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>check-circle<span class=\"token punctuation\">\"</span></span><span class=\"token punctuation\">></span></span>Borderless with Icon<span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>nz-tag</span><span class=\"token punctuation\">></span></span>\n        <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;</span>nz-tag</span> <span class=\"token attr-name\">nzDisabled</span> <span class=\"token attr-name\">nzVariant</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>filled<span class=\"token punctuation\">\"</span></span> <span class=\"token attr-name\">nzMode</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>closeable<span class=\"token punctuation\">\"</span></span> <span class=\"token attr-name\">(nzOnClose)</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>onClose('Borderless Closable')<span class=\"token punctuation\">\"</span></span><span class=\"token punctuation\">></span></span>\n          Borderless Closable\n        <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>nz-tag</span><span class=\"token punctuation\">></span></span>\n      <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>div</span><span class=\"token punctuation\">></span></span>\n    <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>div</span><span class=\"token punctuation\">></span></span>\n  `</span></span>\n<span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span>\n<span class=\"token keyword\">export</span> <span class=\"token keyword\">class</span> <span class=\"token class-name\">NzDemoTagDisabledComponent</span> <span class=\"token punctuation\">{</span>\n  <span class=\"token keyword\">readonly</span> tags <span class=\"token operator\">=</span> <span class=\"token punctuation\">[</span><span class=\"token string\">'Books'</span><span class=\"token punctuation\">,</span> <span class=\"token string\">'Movies'</span><span class=\"token punctuation\">,</span> <span class=\"token string\">'Music'</span><span class=\"token punctuation\">]</span><span class=\"token punctuation\">;</span>\n  <span class=\"token keyword\">readonly</span> selectedTags <span class=\"token operator\">=</span> <span class=\"token punctuation\">[</span><span class=\"token string\">'Books'</span><span class=\"token punctuation\">]</span><span class=\"token punctuation\">;</span>\n\n  <span class=\"token function\">onClose</span><span class=\"token punctuation\">(</span>name<span class=\"token operator\">:</span> <span class=\"token builtin\">string</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token builtin\">console</span><span class=\"token punctuation\">.</span><span class=\"token function\">log</span><span class=\"token punctuation\">(</span>`Tag $<span class=\"token punctuation\">{</span>name<span class=\"token punctuation\">}</span> closed`<span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"import { Component } from '@angular/core';\n\nimport { NzFlexModule } from 'ng-zorro-antd/flex';\nimport { NzTagModule } from 'ng-zorro-antd/tag';\n\n@Component({\n  selector: 'nz-demo-tag-disabled',\n  imports: [NzFlexModule, NzTagModule],\n  template: `\n    <div nz-flex nzVertical nzGap=\"medium\">\n      <div nz-flex nzGap=\"small\" nzWrap=\"wrap\">\n        <nz-tag nzDisabled>Basic Tag</nz-tag>\n        <nz-tag nzDisabled><a href=\"https://ng.ant.design\">Link Tag</a></nz-tag>\n        <nz-tag nzDisabled nzColor=\"success\" nzIcon=\"check-circle\">Icon Tag</nz-tag>\n      </div>\n      <div nz-flex nzGap=\"small\" nzWrap=\"wrap\">\n        <nz-tag nzDisabled nzColor=\"red\">Preset Color Red</nz-tag>\n        <nz-tag nzDisabled nzColor=\"#f50\">Custom Color #f50 Outlined</nz-tag>\n        <nz-tag nzDisabled nzColor=\"#f50\" nzVariant=\"solid\">Custom Color #f50 Filled</nz-tag>\n        <nz-tag nzDisabled nzColor=\"#f50\" nzVariant=\"filled\">Custom Color #f50 Borderless</nz-tag>\n        <nz-tag nzDisabled nzColor=\"success\">Preset Status Success</nz-tag>\n      </div>\n      <div nz-flex nzGap=\"small\" nzWrap=\"wrap\">\n        @for (tag of tags; track tag) {\n          <nz-tag nzMode=\"checkable\" nzDisabled [nzChecked]=\"selectedTags.includes(tag)\">{{ tag }}</nz-tag>\n        }\n      </div>\n      <div nz-flex nzGap=\"small\" nzWrap=\"wrap\">\n        <nz-tag nzDisabled nzMode=\"closeable\" (nzOnClose)=\"onClose('Closable')\">Closable Tag</nz-tag>\n        <nz-tag\n          nzDisabled\n          nzMode=\"closeable\"\n          nzColor=\"success\"\n          nzIcon=\"check-circle\"\n          (nzOnClose)=\"onClose('Closable Success')\"\n        >\n          Closable with Icon\n        </nz-tag>\n      </div>\n      <div nz-flex nzGap=\"small\" nzWrap=\"wrap\">\n        <nz-tag nzDisabled nzVariant=\"filled\">Borderless Basic</nz-tag>\n        <nz-tag nzDisabled nzVariant=\"filled\" nzColor=\"success\" nzIcon=\"check-circle\">Borderless with Icon</nz-tag>\n        <nz-tag nzDisabled nzVariant=\"filled\" nzMode=\"closeable\" (nzOnClose)=\"onClose('Borderless Closable')\">\n          Borderless Closable\n        </nz-tag>\n      </div>\n    </div>\n  `\n})\nexport class NzDemoTagDisabledComponent {\n  readonly tags = ['Books', 'Movies', 'Music'];\n  readonly selectedTags = ['Books'];\n\n  onClose(name: string): void {\n    console.log(`Tag ${name} closed`);\n  }\n}\n"}
