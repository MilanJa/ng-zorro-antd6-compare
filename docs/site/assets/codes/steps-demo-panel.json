/span> <span class=\"token attr-name\">nzContent</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>This is a content.<span class=\"token punctuation\">\"</span></span> <span class=\"token punctuation\">/></span></span>\n        <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>nz-steps</span><span class=\"token punctuation\">></span></span>\n      }\n    <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>div</span><span class=\"token punctuation\">></span></span>\n  `</span></span>\n<span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span>\n<span class=\"token keyword\">export</span> <span class=\"token keyword\">class</span> <span class=\"token class-name\">NzDemoStepsPanelComponent</span> <span class=\"token punctuation\">{</span>\n  <span class=\"token keyword\">readonly</span> current <span class=\"token operator\">=</span> <span class=\"token function\">signal</span><span class=\"token punctuation\">(</span><span class=\"token number\">0</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"/**\n * Use of this source code is governed by an MIT-style license that can be\n * found in the LICENSE file at https://github.com/NG-ZORRO/ng-zorro-antd/blob/master/LICENSE\n */\nimport { Component, signal } from '@angular/core';\n\nimport { NzStepsModule } from 'ng-zorro-antd/steps';\n\n@Component({\n  selector: 'nz-demo-steps-panel',\n  imports: [NzStepsModule],\n  template: `\n    <div style=\"display: flex; flex-direction: column; gap: 16px\">\n      @for (outlined of [false, true]; track outlined) {\n        <nz-steps\n          nzType=\"panel\"\n          [nzCurrent]=\"current()\"\n          [nzSize]=\"outlined ? 'small' : 'default'\"\n          [nzVariant]=\"outlined ? 'outlined' : 'filled'\"\n          (nzIndexChange)=\"current.set($event)\"\n        >\n          <nz-step nzTitle=\"Step 1\" nzSubtitle=\"00:00\" nzContent=\"This is a content.\" />\n          <nz-step nzTitle=\"Step 2\" nzContent=\"This is a content.\" nzStatus=\"error\" />\n          <nz-step nzTitle=\"Step 3\" nzContent=\"This is a content.\" />\n        </nz-steps>\n      }\n    </div>\n  `\n})\nexport class NzDemoStepsPanelComponent {\n  readonly current = signal(0);\n}\n"}
