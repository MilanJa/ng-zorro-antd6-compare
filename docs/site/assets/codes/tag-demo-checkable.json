nctuation\">\"</span></span><span class=\"token punctuation\">></span></span>Multiple<span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>nz-form-label</span><span class=\"token punctuation\">></span></span>\n        <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;</span>nz-form-control</span><span class=\"token punctuation\">></span></span>\n          <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;</span>nz-tag-checkable-group</span> <span class=\"token attr-name\">name</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>multiple<span class=\"token punctuation\">\"</span></span> <span class=\"token attr-name\">[(ngModel)]</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>multipleSelected<span class=\"token punctuation\">\"</span></span><span class=\"token punctuation\">></span></span>\n            @for (tag of tagsData; track tag) {\n              <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;</span>nz-tag</span> <span class=\"token attr-name\">nzMode</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>checkable<span class=\"token punctuation\">\"</span></span> <span class=\"token attr-name\">[nzValue]</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>tag<span class=\"token punctuation\">\"</span></span><span class=\"token punctuation\">></span></span>{{ tag }}<span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>nz-tag</span><span class=\"token punctuation\">></span></span>\n            }\n          <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>nz-tag-checkable-group</span><span class=\"token punctuation\">></span></span>\n        <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>nz-form-control</span><span class=\"token punctuation\">></span></span>\n      <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>nz-form-item</span><span class=\"token punctuation\">></span></span>\n    <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>form</span><span class=\"token punctuation\">></span></span>\n  `</span></span>\n<span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span>\n<span class=\"token keyword\">export</span> <span class=\"token keyword\">class</span> <span class=\"token class-name\">NzDemoTagCheckableComponent</span> <span class=\"token punctuation\">{</span>\n  <span class=\"token keyword\">readonly</span> tagsData <span class=\"token operator\">=</span> <span class=\"token punctuation\">[</span><span class=\"token string\">'Movies'</span><span class=\"token punctuation\">,</span> <span class=\"token string\">'Books'</span><span class=\"token punctuation\">,</span> <span class=\"token string\">'Music'</span><span class=\"token punctuation\">,</span> <span class=\"token string\">'Sports'</span><span class=\"token punctuation\">]</span><span class=\"token punctuation\">;</span>\n  checked <span class=\"token operator\">=</span> <span class=\"token boolean\">true</span><span class=\"token punctuation\">;</span>\n  singleSelected<span class=\"token operator\">:</span> NzTagCheckableValue <span class=\"token operator\">|</span> <span class=\"token keyword\">null</span> <span class=\"token operator\">=</span> <span class=\"token string\">'Books'</span><span class=\"token punctuation\">;</span>\n  multipleSelected<span class=\"token operator\">:</span> NzTagCheckableValue<span class=\"token punctuation\">[</span><span class=\"token punctuation\">]</span> <span class=\"token operator\">=</span> <span class=\"token punctuation\">[</span><span class=\"token string\">'Movies'</span><span class=\"token punctuation\">,</span> <span class=\"token string\">'Music'</span><span class=\"token punctuation\">]</span><span class=\"token punctuation\">;</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"import { Component } from '@angular/core';\nimport { FormsModule } from '@angular/forms';\n\nimport { NzFormModule } from 'ng-zorro-antd/form';\nimport { NzTagCheckableValue, NzTagModule } from 'ng-zorro-antd/tag';\n\n@Component({\n  selector: 'nz-demo-tag-checkable',\n  imports: [FormsModule, NzFormModule, NzTagModule],\n  template: `\n    <form nz-form>\n      <nz-form-item>\n        <nz-form-label [nzSpan]=\"6\">Checkable</nz-form-label>\n        <nz-form-control>\n          <nz-tag nzMode=\"checkable\" [(nzChecked)]=\"checked\">Yes</nz-tag>\n        </nz-form-control>\n      </nz-form-item>\n      <nz-form-item>\n        <nz-form-label [nzSpan]=\"6\">Single</nz-form-label>\n        <nz-form-control>\n          <nz-tag-checkable-group name=\"single\" [nzMultiple]=\"false\" [(ngModel)]=\"singleSelected\">\n            @for (tag of tagsData; track tag) {\n              <nz-tag nzMode=\"checkable\" [nzValue]=\"tag\">{{ tag }}</nz-tag>\n            }\n          </nz-tag-checkable-group>\n        </nz-form-control>\n      </nz-form-item>\n      <nz-form-item>\n        <nz-form-label [nzSpan]=\"6\">Multiple</nz-form-label>\n        <nz-form-control>\n          <nz-tag-checkable-group name=\"multiple\" [(ngModel)]=\"multipleSelected\">\n            @for (tag of tagsData; track tag) {\n              <nz-tag nzMode=\"checkable\" [nzValue]=\"tag\">{{ tag }}</nz-tag>\n            }\n          </nz-tag-checkable-group>\n        </nz-form-control>\n      </nz-form-item>\n    </form>\n  `\n})\nexport class NzDemoTagCheckableComponent {\n  readonly tagsData = ['Movies', 'Books', 'Music', 'Sports'];\n  checked = true;\n  singleSelected: NzTagCheckableValue | null = 'Books';\n  multipleSelected: NzTagCheckableValue[] = ['Movies', 'Music'];\n}\n"}
