'</span><span class=\"token punctuation\">,</span> current<span class=\"token operator\">:</span> <span class=\"token number\">1</span><span class=\"token punctuation\">,</span> status<span class=\"token operator\">:</span> <span class=\"token string\">'error'</span> <span class=\"token punctuation\">}</span><span class=\"token punctuation\">,</span>\n    <span class=\"token punctuation\">{</span> title<span class=\"token operator\">:</span> <span class=\"token string\">'Ant Design Title 3'</span><span class=\"token punctuation\">,</span> current<span class=\"token operator\">:</span> <span class=\"token number\">2</span><span class=\"token punctuation\">,</span> status<span class=\"token operator\">:</span> <span class=\"token string\">'process'</span> <span class=\"token punctuation\">}</span><span class=\"token punctuation\">,</span>\n    <span class=\"token punctuation\">{</span> title<span class=\"token operator\">:</span> <span class=\"token string\">'Ant Design Title 4'</span><span class=\"token punctuation\">,</span> current<span class=\"token operator\">:</span> <span class=\"token number\">1</span><span class=\"token punctuation\">,</span> status<span class=\"token operator\">:</span> <span class=\"token string\">'process'</span> <span class=\"token punctuation\">}</span>\n  <span class=\"token punctuation\">]</span><span class=\"token punctuation\">;</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"/**\n * Use of this source code is governed by an MIT-style license that can be\n * found in the LICENSE file at https://github.com/NG-ZORRO/ng-zorro-antd/blob/master/LICENSE\n */\nimport { Component } from '@angular/core';\n\nimport { NzListModule } from 'ng-zorro-antd/list';\nimport { NzStatusType, NzStepsModule } from 'ng-zorro-antd/steps';\n\n@Component({\n  selector: 'nz-demo-steps-inline',\n  imports: [NzListModule, NzStepsModule],\n  template: `\n    <nz-list nzItemLayout=\"horizontal\">\n      @for (item of data; track item.title) {\n        <nz-list-item>\n          <nz-list-item-meta\n            [nzAvatar]=\"'https://api.dicebear.com/10.x/lorelei/svg?seed=' + $index\"\n            [nzTitle]=\"titleTpl\"\n            nzDescription=\"Ant Design, a design language for background applications, is refined by Ant UED Team\"\n          />\n          <ng-template #titleTpl\n            ><a href=\"https://ng.ant.design\">{{ item.title }}</a></ng-template\n          >\n          <nz-steps style=\"margin-top: 8px\" nzType=\"inline\" [nzCurrent]=\"item.current\" [nzStatus]=\"item.status\">\n            <nz-step nzTitle=\"Step 1\" nzContent=\"This is Step 1\" />\n            <nz-step nzTitle=\"Step 2\" nzContent=\"This is Step 2\" />\n            <nz-step nzTitle=\"Step 3\" nzContent=\"This is Step 3\" />\n          </nz-steps>\n        </nz-list-item>\n      }\n    </nz-list>\n  `\n})\nexport class NzDemoStepsInlineComponent {\n  readonly data: Array<{ title: string; current: number; status: NzStatusType }> = [\n    { title: 'Ant Design Title 1', current: 0, status: 'process' },\n    { title: 'Ant Design Title 2', current: 1, status: 'error' },\n    { title: 'Ant Design Title 3', current: 2, status: 'process' },\n    { title: 'Ant Design Title 4', current: 1, status: 'process' }\n  ];\n}\n"}
